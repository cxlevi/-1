<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Список задач</title>
  <style>
    body { font-family: Arial; padding: 20px; }
    .task { padding: 10px; margin: 5px 0; border: 1px solid #ccc; cursor: pointer; }
    .task.completed { text-decoration: line-through; color: gray; }
    .summary { margin: 20px 0; padding: 10px; background: #f0f0f0; }
    button { margin: 5px; padding: 5px 15px; }
    button.active { background: #4CAF50; color: white; }
  </style>
</head>
<body>
  <h2>Список задач</h2>
  
  <div>
    <button id="filter-all">Все</button>
    <button id="filter-pending">В работе</button>
    <button id="filter-completed">Завершено</button>
  </div>
  
  <div class="summary" id="summary"></div>
  
  <div id="task-list"></div>

  <script>
    let tasks = [
      { id: 1,  title: 'Задача 1',  completed: true  },
      { id: 4,  title: 'Задача 4',  completed: false },
      { id: 7,  title: 'Задача 7',  completed: false },
      { id: 10, title: 'Задача 10', completed: true  }
    ];

    let currentFilter = 'all';

    function setTaskCompleted(tasks, id, completed) {
      const taskExists = tasks.some(task => task.id === id);
      if (!taskExists) return { ok: false, error: 'Задача не найдена' };
      
      const newTasks = tasks.map(task => {
        if (task.id === id) {
          return { ...task, completed: completed };
        }
        return task;
      });
      return { ok: true, tasks: newTasks };
    }

    function renderSummary() {
      const total = tasks.length;
      const completed = tasks.filter(t => t.completed).length;
      const pending = total - completed;
      const percent = total > 0 ? (completed / total * 100).toFixed(1) : 0;
      
      document.getElementById('summary').innerHTML = 
        `Всего: ${total}, выполнено: ${completed}, осталось: ${pending}, прогресс: ${percent}%`;
    }

    function renderTasks() {
      const list = document.getElementById('task-list');
      list.innerHTML = '';
      
      let filteredTasks = tasks;
      if (currentFilter === 'pending') {
        filteredTasks = tasks.filter(t => !t.completed);
      } else if (currentFilter === 'completed') {
        filteredTasks = tasks.filter(t => t.completed);
      }
      
      filteredTasks.forEach(task => {
        const div = document.createElement('div');
        div.className = 'task' + (task.completed ? ' completed' : '');
        div.textContent = `ID ${task.id}: ${task.title}`;
        
        div.addEventListener('click', () => {
          const result = setTaskCompleted(tasks, task.id, !task.completed);
          if (result.ok) {
            tasks = result.tasks;
            renderTasks();
            renderSummary();
          }
        });
        
        list.appendChild(div);
      });
    }

    document.getElementById('filter-all').addEventListener('click', () => {
      currentFilter = 'all';
      renderTasks();
    });
    document.getElementById('filter-pending').addEventListener('click', () => {
      currentFilter = 'pending';
      renderTasks();
    });
    document.getElementById('filter-completed').addEventListener('click', () => {
      currentFilter = 'completed';
      renderTasks();
    });

    renderTasks();
    renderSummary();
  </script>
</body>
</html>
